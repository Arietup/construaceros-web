---
import { ANIOS_EXPERIENCIA, PROVINCIAS_ATENDIDAS } from '../config';

const cifras = [
  { valor: ANIOS_EXPERIENCIA, sufijo: '', etiqueta: 'Años de experiencia' },
  // Derivada de la lista: la cifra y el mapa de cobertura no pueden contradecirse.
  { valor: PROVINCIAS_ATENDIDAS.length, sufijo: '', etiqueta: 'Provincias atendidas' },
  { valor: 100, sufijo: '%', etiqueta: 'Obras con garantía' },
];
---

<section class="border-y border-white/10 bg-grafito">
  <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 sm:grid-cols-3">
    {cifras.map((c) => (
      <div class="reveal text-center">
        <p class="font-display text-6xl text-ambar">
          <span data-contador={c.valor}>{c.valor}</span>{c.sufijo}
        </p>
        <p class="mt-2 text-sm tracking-widest text-acero uppercase">{c.etiqueta}</p>
      </div>
    ))}
  </div>
</section>
